PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Seconds a disconnected player keeps their seat before leaving / forfeiting (optional, default 60)
DISCONNECT_GRACE_SECONDS=60
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only used by `npm run smoke` (it plays the part of the browser). The server itself never reads it.
SUPABASE_PUBLISHABLE_KEY=
